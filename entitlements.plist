<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone / BlackHole capture goes through CoreAudio input, which is
         gated by this entitlement under the hardened runtime. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- CPython + PyInstaller need these under the hardened runtime: the
         interpreter generates executable memory and loads unsigned .so/.dylib
         extension modules (numpy, ctranslate2, sounddevice/PortAudio, etc.). -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
